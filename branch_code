import { Search, Menu, MoreVertical, Plus, X, Edit2, Check } from "lucide-react";
import { useState } from "react";

export default function App() {
  const [searchQuery, setSearchQuery] = useState("Product management");
  const [navTabs, setNavTabs] = useState(["All", "Images", "Videos", "News", "Maps"]);
  const [activeTab, setActiveTab] = useState(0);
  
 
      id: 2,
      favicon: "P",
      domain: "pluralsight.com",
      url: "https://pluralsight.com",
      title: "Exploring a Product Management Career",
      hasAd: true,
      description: "Access on-demand courses in AI, cloud, security, and more — anytime, anywhere. Learn tech skills on your time, with over 7,000 hands-on courses across key disciplines.",
      links: [
        { title: "Get Started", subtitle: "" },
        { title: "Start a Free Trial Today!", subtitle: "" },
        { title: "For Individuals", subtitle: "" },
        { title: "Software Development..", subtitle: "" },
      ]
    },
    {
      id: 3,
      favicon: "C",
      domain: "catchwork.jobs",
      url: "https://in.catchwork.jobs › urgent › job",
      title: "Product management job - Urgently Hiring Now",
      hasAd: true,
      description: "Product management job. The Highest Paid Jobs in India. Product management job Job: View all our Urgent Vacancies now",
      additionalInfo: "Event Manager Jobs · Continue to apply · US-based job listings",
      links: []
    },
  ]);

  const [relatedSearches, setRelatedSearches] = useState([
    "product management definition",
    "product management meaning",
    "product management step by step",
    "product management job description",
    "product management vs project management",
    "product management roles and responsibilities",
    "product management pdf",
    "product management examples",
  ]);

  const [filterButtons, setFilterButtons] = useState([
    { icon: "🛡️", text: "Protected" },
    { icon: "•", text: "" },
    { icon: "", text: "India (en)" },
    { icon: "", text: "Safe search: moderate" },
    { icon: "", text: "Any time" },
  ]);

  const [sidebarTitle, setSidebarTitle] = useState("Searches related to");
  const [feedbackButtonText, setFeedbackButtonText] = useState("Share Feedback");
  const [bannerText, setBannerText] = useState("🖊️ Edit Mode Active - Click on any text to edit it");

  const [editingResultId, setEditingResultId] = useState<number | null>(null);
  const [editingSearchIndex, setEditingSearchIndex] = useState<number | null>(null);
  const [editingTabIndex, setEditingTabIndex] = useState<number | null>(null);
  const [editingFilterIndex, setEditingFilterIndex] = useState<number | null>(null);
  const [editingLinkIndex, setEditingLinkIndex] = useState<{ resultId: number; linkIndex: number } | null>(null);

  const updateSearchResult = (id: number, field: string, value: any) => {
    setSearchResults(prev => prev.map(result => 
      result.id === id ? { ...result, [field]: value } : result
    ));
  };

  const updateLink = (resultId: number, linkIndex: number, field: string, value: string) => {
    setSearchResults(prev => prev.map(result => {
      if (result.id === resultId) {
        const newLinks = [...result.links];
        newLinks[linkIndex] = { ...newLinks[linkIndex], [field]: value };
        return { ...result, links: newLinks };
      }
      return result;
    }));
  };

  const deleteLink = (resultId: number, linkIndex: number) => {
    setSearchResults(prev => prev.map(result => {
      if (result.id === resultId) {
        return { ...result, links: result.links.filter((_, idx) => idx !== linkIndex) };
      }
      return result;
    }));
  };

  const addLink = (resultId: number) => {
    setSearchResults(prev => prev.map(result => {
      if (result.id === resultId) {
        return { 
          ...result, 
          links: [...result.links, { title: "New Link", subtitle: "Subtitle here" }] 
        };
      }
      return result;
    }));
  };

  const deleteSearchResult = (id: number) => {
    setSearchResults(prev => prev.filter(result => result.id !== id));
  };

  const addNewSearchResult = () => {
    const newId = Math.max(...searchResults.map(r => r.id)) + 1;
    setSearchResults(prev => [...prev, {
      id: newId,
      favicon: "N",
      domain: "newsite.com",
      url: "https://newsite.com",
      title: "New Search Result - Click to Edit",
      hasAd: false,
      description: "This is a new search result. Click the edit icon to customize it.",
      additionalInfo: "",
      links: []
    }]);
  };

  const updateRelatedSearch = (index: number, value: string) => {
    setRelatedSearches(prev => prev.map((search, idx) => 
      idx === index ? value : search
    ));
  };

  const deleteRelatedSearch = (index: number) => {
    setRelatedSearches(prev => prev.filter((_, idx) => idx !== index));
  };

  const addNewRelatedSearch = () => {
    setRelatedSearches(prev => [...prev, "new search term"]);
    setEditingSearchIndex(relatedSearches.length);
  };

  const updateNavTab = (index: number, value: string) => {
    setNavTabs(prev => prev.map((tab, idx) => idx === index ? value : tab));
  };

  const deleteNavTab = (index: number) => {
    if (navTabs.length > 1) {
      setNavTabs(prev => prev.filter((_, idx) => idx !== index));
      if (activeTab >= index && activeTab > 0) setActiveTab(activeTab - 1);
    }
  };

  const addNavTab = () => {
    setNavTabs(prev => [...prev, "New Tab"]);
    setEditingTabIndex(navTabs.length);
  };

  const updateFilter = (index: number, value: string) => {
    setFilterButtons(prev => prev.map((filter, idx) => 
      idx === index ? { ...filter, text: value } : filter
    ));
  };

  return (
    <div className="min-h-screen bg-[#222222] text-white">
      {/* Edit Mode Banner - Editable */}
      <div className="bg-blue-600 text-white px-6 py-2 text-center text-sm">
        <input
          type="text"
          value={bannerText}
          onChange={(e) => setBannerText(e.target.value)}
          className="bg-transparent text-center outline-none border-b border-transparent hover:border-white focus:border-white w-full max-w-2xl mx-auto"
        />
      </div>

      {/* Header */}
      <header className="bg-[#2d2d2d] border-b border-[#3a3a3a]">
        <div className="px-6 py-3 flex items-center gap-6">
          {/* Logo */}
          <div className="flex items-center gap-2">
            <div className="w-9 h-9 bg-[#de5833] rounded-full flex items-center justify-center flex-shrink-0">
              <div className="w-7 h-7 relative">
                <svg viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="10" r="8" />
                  <ellipse cx="10" cy="9" rx="1.5" ry="2" fill="#2d2d2d" />
                  <path d="M 8 12 Q 12 14 16 12" stroke="#2d2d2d" strokeWidth="1.5" fill="none" strokeLinecap="round"/>
                  <path d="M 18 8 L 20 6 L 19 8 Z" fill="white"/>
                </svg>
              </div>
            </div>
          </div>

          {/* Search Bar */}
          <div className="flex-1 max-w-2xl">
            <div className="relative">
              <input
                type="text"
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="w-full bg-[#3a3a3a] text-white placeholder-gray-400 rounded px-4 py-2 pr-10 outline-none focus:ring-2 focus:ring-[#5e8eff]"
              />
              <button className="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white">
                <Search className="w-4 h-4" />
              </button>
            </div>
          </div>

          {/* Menu Icon */}
          <button className="text-gray-400 hover:text-white ml-auto">
            <Menu className="w-5 h-5" />
          </button>
        </div>

        {/* Navigation Tabs - Editable */}
        <div className="px-6 flex items-center gap-6 border-b border-[#3a3a3a]">
          {navTabs.map((tab, idx) => (
            <div key={idx} className="flex items-center gap-1 group/tab">
              {editingTabIndex === idx ? (
                <input
                  type="text"
                  value={tab}
                  onChange={(e) => updateNavTab(idx, e.target.value)}
                  onBlur={() => setEditingTabIndex(null)}
                  onKeyDown={(e) => e.key === 'Enter' && setEditingTabIndex(null)}
                  className="bg-[#3a3a3a] px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500 w-20"
                  autoFocus
                />
              ) : (
                <button 
                  onClick={() => setActiveTab(idx)}
                  onDoubleClick={() => setEditingTabIndex(idx)}
                  className={`py-3 ${activeTab === idx ? 'text-[#5e8eff] border-b-2 border-[#5e8eff]' : 'text-gray-400 hover:text-white'}`}
                >
                  {tab}
                </button>
              )}
              {editingTabIndex !== idx && (
                <button 
                  onClick={() => deleteNavTab(idx)}
                  className="opacity-0 group-hover/tab:opacity-100 text-gray-400 hover:text-red-500 p-0.5"
                >
                  <X className="w-3 h-3" />
                </button>
              )}
            </div>
          ))}
          <button 
            onClick={addNavTab}
            className="text-gray-400 hover:text-blue-500 py-3"
          >
            <Plus className="w-4 h-4" />
          </button>

          <div className="ml-auto flex items-center gap-4">
            <button className="text-gray-400 hover:text-white text-sm flex items-center gap-1">
              <span className="text-[#5e8eff]">⚡</span> Search Assist
            </button>
            <button className="text-gray-400 hover:text-white text-sm flex items-center gap-1">
              <span>🤖</span> Duck.ai
            </button>
            <button className="text-gray-400 hover:text-white">
              <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 1v6m0 6v6m9-9h-6m-6 0H3"/>
              </svg>
            </button>
          </div>
        </div>

        {/* Filters - Editable */}
        <div className="px-6 py-3 flex items-center gap-4 text-sm">
          {filterButtons.map((filter, idx) => (
            <div key={idx} className="flex items-center gap-2 group/filter">
              {editingFilterIndex === idx ? (
                <input
                  type="text"
                  value={filter.text}
                  onChange={(e) => updateFilter(idx, e.target.value)}
                  onBlur={() => setEditingFilterIndex(null)}
                  onKeyDown={(e) => e.key === 'Enter' && setEditingFilterIndex(null)}
                  className="bg-[#3a3a3a] px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500"
                  autoFocus
                />
              ) : (
                <button 
                  onDoubleClick={() => setEditingFilterIndex(idx)}
                  className="flex items-center gap-2 px-3 py-1.5 rounded bg-[#3a3a3a] hover:bg-[#4a4a4a]"
                >
                  {filter.icon && <span className={filter.icon === '🛡️' ? 'text-green-500' : ''}>{filter.icon === '•' ? <span className="w-2 h-2 bg-white rounded-full inline-block"></span> : filter.icon}</span>}
                  {filter.text && <span>{filter.text}</span>}
                  {filter.text && <span className="text-gray-400">▼</span>}
                </button>
              )}
            </div>
          ))}
        </div>
      </header>

      {/* Main Content */}
      <div className="max-w-[1400px] mx-auto px-6 py-6 flex gap-8">
        {/* Search Results */}
        <div className="flex-1 max-w-3xl space-y-6">
          {/* Add New Result Button */}
          <button 
            onClick={addNewSearchResult}
            className="w-full border-2 border-dashed border-gray-600 hover:border-blue-500 rounded-lg py-4 flex items-center justify-center gap-2 text-gray-400 hover:text-blue-500 transition-colors"
          >
            <Plus className="w-5 h-5" />
            <span>Add New Search Result</span>
          </button>

          {searchResults.map((result) => (
            <div key={result.id} className="group bg-[#2d2d2d] rounded-lg p-4 hover:bg-[#333333] transition-colors">
              {/* Result Header */}
              <div className="flex items-start justify-between mb-2">
                <div className="flex items-center gap-2 flex-1">
                  <input
                    type="text"
                    value={result.favicon}
                    onChange={(e) => updateSearchResult(result.id, 'favicon', e.target.value)}
                    className="w-6 h-6 bg-gray-600 rounded-sm flex items-center justify-center text-xs text-center outline-none focus:ring-2 focus:ring-blue-500"
                    maxLength={1}
                    title="Click to edit favicon"
                  />
                  <div className="flex-1">
                    {editingResultId === result.id ? (
                      <>
                        <input
                          type="text"
                          value={result.domain}
                          onChange={(e) => updateSearchResult(result.id, 'domain', e.target.value)}
                          className="w-full bg-[#3a3a3a] text-sm px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500 mb-1"
                          placeholder="Domain"
                        />
                        <input
                          type="text"
                          value={result.url}
                          onChange={(e) => updateSearchResult(result.id, 'url', e.target.value)}
                          className="w-full bg-[#3a3a3a] text-xs text-gray-400 px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500"
                          placeholder="URL"
                        />
                      </>
                    ) : (
                      <>
                        <div className="text-sm">{result.domain}</div>
                        <div className="text-xs text-gray-400">{result.url}</div>
                      </>
                    )}
                  </div>
                </div>
                <div className="flex items-center gap-2">
                  <button 
                    onClick={() => updateSearchResult(result.id, 'hasAd', !result.hasAd)}
                    className={`text-xs px-2 py-0.5 border rounded ${result.hasAd ? 'border-gray-600 text-gray-400' : 'border-transparent text-gray-600'}`}
                    title="Toggle AD badge"
                  >
                    AD
                  </button>
                  <button 
                    onClick={() => setEditingResultId(editingResultId === result.id ? null : result.id)}
                    className="text-gray-400 hover:text-blue-500"
                  >
                    {editingResultId === result.id ? <Check className="w-5 h-5" /> : <Edit2 className="w-5 h-5" />}
                  </button>
                  <button 
                    onClick={() => deleteSearchResult(result.id)}
                    className="text-gray-400 hover:text-red-500"
                  >
                    <X className="w-5 h-5" />
                  </button>
                </div>
              </div>

              {/* Title */}
              {editingResultId === result.id ? (
                <input
                  type="text"
                  value={result.title}
                  onChange={(e) => updateSearchResult(result.id, 'title', e.target.value)}
                  className="w-full bg-[#3a3a3a] text-[#6796e6] px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500 mb-2"
                  placeholder="Title"
                />
              ) : (
                <h2 className="text-[#6796e6] hover:underline cursor-pointer mb-2 flex items-center gap-2">
                  {result.title}
                  {result.hasAd && (
                    <span className="text-xs px-2 py-0.5 border border-gray-600 rounded text-gray-400">AD</span>
                  )}
                </h2>
              )}

              {/* Description */}
              {editingResultId === result.id ? (
                <textarea
                  value={result.description}
                  onChange={(e) => updateSearchResult(result.id, 'description', e.target.value)}
                  className="w-full bg-[#3a3a3a] text-gray-300 text-sm px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500 mb-2 resize-none"
                  rows={3}
                  placeholder="Description"
                />
              ) : (
                <p className="text-sm text-gray-300 mb-2">{result.description}</p>
              )}

              {/* Additional Info */}
              {editingResultId === result.id ? (
                <input
                  type="text"
                  value={result.additionalInfo}
                  onChange={(e) => updateSearchResult(result.id, 'additionalInfo', e.target.value)}
                  placeholder="Additional info (optional)"
                  className="w-full bg-[#3a3a3a] text-gray-400 text-sm px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500 mb-3"
                />
              ) : (
                result.additionalInfo && <p className="text-sm text-gray-400 mb-3">{result.additionalInfo}</p>
              )}

              {/* Links Grid - Editable */}
              {(result.links.length > 0 || editingResultId === result.id) && (
                <div className="mt-3">
                  <div className="grid grid-cols-2 gap-4">
                    {result.links.map((link, linkIdx) => (
                      <div key={linkIdx} className="group/link relative">
                        {editingLinkIndex?.resultId === result.id && editingLinkIndex?.linkIndex === linkIdx ? (
                          <div className="space-y-1">
                            <input
                              type="text"
                              value={link.title}
                              onChange={(e) => updateLink(result.id, linkIdx, 'title', e.target.value)}
                              className="w-full bg-[#3a3a3a] text-[#6796e6] text-sm px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Link title"
                            />
                            <input
                              type="text"
                              value={link.subtitle}
                              onChange={(e) => updateLink(result.id, linkIdx, 'subtitle', e.target.value)}
                              className="w-full bg-[#3a3a3a] text-gray-400 text-xs px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Link subtitle (optional)"
                            />
                          </div>
                        ) : (
                          <div onDoubleClick={() => setEditingLinkIndex({ resultId: result.id, linkIndex: linkIdx })}>
                            <div className="text-sm text-[#6796e6] hover:underline cursor-pointer">
                              {link.title}
                            </div>
                            {link.subtitle && (
                              <div className="text-xs text-gray-400 mt-0.5">{link.subtitle}</div>
                            )}
                          </div>
                        )}
                        {editingResultId === result.id && (
                          <button
                            onClick={() => deleteLink(result.id, linkIdx)}
                            className="absolute -top-1 -right-1 opacity-0 group-hover/link:opacity-100 bg-red-500 hover:bg-red-600 rounded-full p-0.5"
                          >
                            <X className="w-3 h-3" />
                          </button>
                        )}
                      </div>
                    ))}
                  </div>
                  {editingResultId === result.id && (
                    <button
                      onClick={() => addLink(result.id)}
                      className="mt-3 w-full border border-dashed border-gray-600 hover:border-blue-500 rounded py-2 flex items-center justify-center gap-2 text-gray-400 hover:text-blue-500 text-sm"
                    >
                      <Plus className="w-4 h-4" />
                      <span>Add Link</span>
                    </button>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>

        {/* Related Searches Sidebar */}
        <div className="w-80 flex-shrink-0">
          <div className="bg-[#2d2d2d] rounded-lg p-4">
            {/* Editable Sidebar Title */}
            <h3 className="mb-4">
              <input
                type="text"
                value={sidebarTitle}
                onChange={(e) => setSidebarTitle(e.target.value)}
                className="bg-transparent outline-none border-b border-transparent hover:border-gray-500 focus:border-blue-500"
              />
              {" "}
              <span className="text-blue-400">{searchQuery}</span>
            </h3>
            <div className="space-y-1">
              {relatedSearches.map((search, idx) => (
                <div key={idx} className="flex items-center gap-2 group/item">
                  {editingSearchIndex === idx ? (
                    <>
                      <Search className="w-4 h-4 text-gray-500 flex-shrink-0" />
                      <input
                        type="text"
                        value={search}
                        onChange={(e) => updateRelatedSearch(idx, e.target.value)}
                        onBlur={() => setEditingSearchIndex(null)}
                        onKeyDown={(e) => e.key === 'Enter' && setEditingSearchIndex(null)}
                        className="flex-1 bg-[#3a3a3a] text-sm text-gray-300 px-2 py-1 rounded outline-none focus:ring-2 focus:ring-blue-500"
                        autoFocus
                      />
                    </>
                  ) : (
                    <>
                      <button
                        onClick={() => setEditingSearchIndex(idx)}
                        className="flex-1 text-left px-3 py-2 rounded hover:bg-[#3a3a3a] text-sm text-gray-300 flex items-center gap-2"
                      >
                        <Search className="w-4 h-4 text-gray-500" />
                        {search}
                      </button>
                      <button 
                        onClick={() => deleteRelatedSearch(idx)}
                        className="opacity-0 group-hover/item:opacity-100 text-gray-400 hover:text-red-500 p-1"
                      >
                        <X className="w-4 h-4" />
                      </button>
                    </>
                  )}
                </div>
              ))}
            </div>

            {/* Add New Related Search */}
            <button 
              onClick={addNewRelatedSearch}
              className="w-full mt-3 border border-dashed border-gray-600 hover:border-blue-500 rounded py-2 flex items-center justify-center gap-2 text-gray-400 hover:text-blue-500 text-sm"
            >
              <Plus className="w-4 h-4" />
              <span>Add Related Search</span>
            </button>
          </div>

          {/* Share Feedback Button - Editable */}
          <div className="mt-6">
            <input
              type="text"
              value={feedbackButtonText}
              onChange={(e) => setFeedbackButtonText(e.target.value)}
              className="w-full bg-[#3a3a3a] hover:bg-[#4a4a4a] text-white px-4 py-2.5 rounded text-center outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>
      </div>
    </div>
  );
}
